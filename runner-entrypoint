#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo --preserve-env=ACTIONS_RUNNER_INPUT_JITCONFIG,RUNNERYARD_DEADLINE /usr/local/bin/runner-entrypoint "$@"
fi

if [[ -z "${ACTIONS_RUNNER_INPUT_JITCONFIG:-}" ]]; then
  echo "ACTIONS_RUNNER_INPUT_JITCONFIG is required" >&2
  exit 64
fi

if [[ -z "${RUNNERYARD_DEADLINE:-}" ]]; then
  echo "RUNNERYARD_DEADLINE is required" >&2
  exit 64
fi

deadline_epoch=$(date --date="$RUNNERYARD_DEADLINE" +%s)
remaining_seconds=$((deadline_epoch - $(date +%s)))
if (( remaining_seconds < 1 )); then
  echo "runner lease is already expired" >&2
  exit 70
fi

mkdir -p /etc/docker /var/lib/docker
docker_root_filesystem="$(findmnt --noheadings --output FSTYPE --target /var/lib/docker | tr -d '[:space:]')"
case "$docker_root_filesystem" in
  overlay|overlayfs)
    # A worker image commonly runs on a provider-managed overlay root. Kernel
    # overlay and Docker's containerd overlay snapshotter cannot safely nest
    # there. fuse-overlayfs preserves layered builds without vfs deep copies.
    if [[ ! -c /dev/fuse ]]; then
      echo "Docker data root uses $docker_root_filesystem but /dev/fuse is unavailable" >&2
      exit 78
    fi
    if ! command -v fuse-overlayfs >/dev/null 2>&1; then
      echo "Docker data root uses $docker_root_filesystem but fuse-overlayfs is unavailable" >&2
      exit 78
    fi
    printf '%s\n' '{"features":{"buildkit":true,"containerd-snapshotter":false},"storage-driver":"fuse-overlayfs"}' >/etc/docker/daemon.json
    ;;
  *)
    # On a plain VM filesystem, retain Docker's native snapshotter. Forcing vfs
    # deep-copies every layer and can exhaust the ephemeral worker disk.
    printf '%s\n' '{"features":{"buildkit":true}}' >/etc/docker/daemon.json
    ;;
esac

dockerd --config-file=/etc/docker/daemon.json >/var/log/dockerd.log 2>&1 &
docker_pid=$!

cleanup() {
  kill "$docker_pid" 2>/dev/null || true
  wait "$docker_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

for _attempt in $(seq 1 60); do
  if docker info >/dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$docker_pid" 2>/dev/null; then
    cat /var/log/dockerd.log >&2
    exit 1
  fi
  sleep 1
done

docker info >/dev/null 2>&1 || {
  cat /var/log/dockerd.log >&2
  exit 1
}

chown runner:docker /var/run/docker.sock
set +e
timeout --signal=TERM --kill-after=30s "${remaining_seconds}s" \
  setpriv --reuid=runner --regid=runner --init-groups \
  env HOME=/home/runner USER=runner LOGNAME=runner \
  RUNNER_TOOL_CACHE=/opt/hostedtoolcache ImageOS=ubuntu24 \
  DOCKER_BUILDKIT=1 \
  XDG_CONFIG_HOME=/home/runner/.config \
  /home/runner/run.sh
runner_status=$?
set -e
exit "$runner_status"
